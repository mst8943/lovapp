# Lovask production environment
# Copy this file to .env.production.local and fill in every required value.
# Never commit .env.production.local.

# Required: Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Required: public URL and request security
NEXT_PUBLIC_APP_URL=https://your-domain.com
CRON_SECRET=GENERATE_A_LONG_RANDOM_VALUE
RATE_LIMIT_HMAC_SECRET=GENERATE_ANOTHER_LONG_RANDOM_VALUE
MEMBERSHIP_ACCESS_HMAC_SECRET=GENERATE_ANOTHER_LONG_RANDOM_VALUE

# Required: at least one AI provider
AI_DEFAULT_PROVIDER=deepseek
AI_FALLBACK_ORDER=openrouter,gemini,openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Admin bootstrap
ADMIN_EMAILS=owner@your-domain.com

# Optional: Google OAuth switch
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Optional: email / SMS notifications (configure one provider if needed)
RESEND_API_KEY=
RESEND_FROM_EMAIL=bildirim@your-domain.com
RESEND_FROM_NAME=Lovask
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=LOVASK

# Optional: Shopier payments
SHOPIER_CLIENT_ID=
SHOPIER_CLIENT_SECRET=
SHOPIER_WEBHOOK_TOKEN=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=473893
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=2126679
LEMON_SQUEEZY_WEEKLY_VARIANT_ID=2126690

# Optional: browser push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@your-domain.com
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Optional: Turnstile protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
